#define SDL_MAIN_HANDLED
#include <SDL2/SDL.h>
#include <cmath>

#include "Core/Logger.h"
#include "Core/Timer.h"
#include "Platform/Window.h"
#include "Renderer/RenderContext.h"
#include "Renderer/Texture2D.h"
#include "Renderer/2D/Renderer2D.h"
#include "Renderer/2D/Camera2D.h"
#include "Renderer/2D/Font.h"
#include "Renderer/3D/Renderer3D.h"
#include "Renderer/3D/Camera3D.h"
#include "Renderer/3D/Mesh.h"
#include "Renderer/3D/Light.h"
#include "Renderer/3D/Grid.h"
#include "Input/InputManager.h"
#include "Input/GamepadManager.h"

// Force discrete GPU on NVIDIA / AMD laptops
extern "C" { __declspec(dllexport) DWORD NvOptimusEnablement = 0x00000001; }
extern "C" { __declspec(dllexport) int   AmdPowerXpressRequestHighPerformance = 1;         }

int main()
{
    const std::string ASSETS = "../../../../../../!_ASSETS/";
    const std::string FONTS = ASSETS + "!_fonts/";
    const std::string MODELS = ASSETS + "!_3D_models/";

    SDL_SetMainReady();
    LOG_INFO("PowerEngine starting...");

    Engine::WindowProps props;
    props.Title = "PowerEngine";
    props.Width = 1280;
    props.Height = 720;
    props.VSync = false;
    props.RefreshRate = 500;

    Engine::Window        window(props);
    Engine::RenderContext renderer(window.GetHWND(),
        window.GetWidth(), window.GetHeight(),
        window.GetVSync(), window.GetRefreshRate());

    Engine::Renderer2D renderer2D;
    if (!renderer2D.Init(&renderer, L"Shaders/Polygon.hlsl"))
    {
        LOG_ERROR("Renderer2D init failed."); return -1;
    }

    Engine::Camera2D camera2D;
    camera2D.SetViewSize((float)window.GetWidth(), (float)window.GetHeight());

    Engine::Font font;
    font.Load(renderer.GetDevice(), FONTS + "montserrat_bold.ttf", 16.f);

    Engine::Renderer3D renderer3D;
    if (!renderer3D.Init(&renderer, L"Shaders/Mesh.hlsl"))
    {
        LOG_ERROR("Renderer3D init failed."); return -1;
    }

    Engine::Grid grid;
    if (!grid.Init(&renderer, L"Shaders/Grid.hlsl", &renderer3D, 100, 1.f))
    {
        LOG_ERROR("Grid init failed."); return -1;
    }

    float fov = 60.f;
    float lightIntensity = 3.f;

    Engine::Camera3D camera3D;
    camera3D.SetPosition(0.f, 5.f, -12.f);
    camera3D.SetRotation(0.25f, 0.f, 0.f);
    camera3D.SetPerspective(fov,
        (float)window.GetWidth() / (float)window.GetHeight(),
        0.1f, 1000.f);

    // ---- Primitives ----
    Engine::Mesh ground;
    ground.CreatePlane(renderer.GetDevice(), 30.f, 30.f);

    Engine::Mesh cube1;
    cube1.CreateCube(renderer.GetDevice(), 2.f);
    cube1.SetPosition(0.f, 1.f, 0.f);

    Engine::Mesh cube2;
    cube2.CreateCube(renderer.GetDevice(), 1.5f);
    cube2.SetPosition(5.f, 0.75f, 3.f);

    Engine::Mesh cube3;
    cube3.CreateCube(renderer.GetDevice(), 1.f);
    cube3.SetPosition(-4.f, 0.5f, 2.f);

    Engine::Mesh sphere1;
    sphere1.CreateSphere(renderer.GetDevice(), 1.2f, 32, 32);
    sphere1.SetPosition(-4.f, 1.2f, -2.f);

    Engine::Mesh sphere2;
    sphere2.CreateSphere(renderer.GetDevice(), 0.8f, 32, 32);
    sphere2.SetPosition(4.f, 0.8f, -1.f);

    Engine::Mesh sphere3;
    sphere3.CreateSphere(renderer.GetDevice(), 1.5f, 32, 32);
    sphere3.SetPosition(0.f, 1.5f, 5.f);

    Engine::Mesh bulb;
    bool bulbLoaded = bulb.Load(renderer.GetDevice(),
        MODELS + "bulb/Low_Poly_Light_Bulb.fbx");
    bulb.SetScale(1.2f);

    Engine::Timer timer; timer.Reset();
    Engine::InputManager::Init();
    Engine::GamepadManager::Init();

    bool showInfo = false;
    bool showCrosshair = false;
    bool showGrid = true;
    bool showShadows = true;
    bool showPtShadows = true;
    int  shadowQuality = 2;

    LOG_INFO("Entering main loop.");

    while (true)
    {
        Engine::InputManager::Update();
        Engine::GamepadManager::Update();
        if (!window.PollEvents()) break;

        timer.Tick();
        const float dt = timer.DeltaTime();

        if (Engine::InputManager::IsMouseButtonPressed(Engine::MouseButton::Right))
            SDL_SetRelativeMouseMode(SDL_TRUE);
        if (Engine::InputManager::IsMouseButtonReleased(Engine::MouseButton::Right))
            SDL_SetRelativeMouseMode(SDL_FALSE);
        if (Engine::InputManager::IsMouseButtonDown(Engine::MouseButton::Right))
        {
            camera3D.Rotate(
                Engine::InputManager::GetMouseDeltaY() * 0.003f,
                Engine::InputManager::GetMouseDeltaX() * 0.003f, 0.f);
        }

        float speed = (Engine::InputManager::IsKeyDown(Engine::Key::LShift) ? 15.f : 5.f) * dt;
        if (Engine::InputManager::IsKeyDown(Engine::Key::W))     camera3D.Move(0, 0, speed);
        if (Engine::InputManager::IsKeyDown(Engine::Key::S))     camera3D.Move(0, 0, -speed);
        if (Engine::InputManager::IsKeyDown(Engine::Key::A))     camera3D.Move(-speed, 0, 0);
        if (Engine::InputManager::IsKeyDown(Engine::Key::D))     camera3D.Move(speed, 0, 0);
        if (Engine::InputManager::IsKeyDown(Engine::Key::Space)) camera3D.Move(0, speed, 0);
        if (Engine::InputManager::IsKeyDown(Engine::Key::LCtrl)) camera3D.Move(0, -speed, 0);

        float scroll = Engine::InputManager::GetMouseScrollDelta();
        if (scroll != 0.f && Engine::InputManager::IsMouseButtonDown(Engine::MouseButton::Right))
            fov = std::max(10.f, std::min(120.f, fov - scroll * 2.f));
        else if (scroll != 0.f && Engine::InputManager::IsKeyDown(Engine::Key::L))
            lightIntensity = std::max(0.f, lightIntensity + scroll * 0.5f);

        if (Engine::InputManager::IsKeyPressed(Engine::Key::F3))  showInfo = !showInfo;
        if (Engine::InputManager::IsKeyPressed(Engine::Key::C))   showCrosshair = !showCrosshair;
        if (Engine::InputManager::IsKeyPressed(Engine::Key::G))   showGrid = !showGrid;
        if (Engine::InputManager::IsKeyPressed(Engine::Key::R))
        {
            camera3D.SetPosition(0.f, 5.f, -12.f);
            camera3D.SetRotation(0.25f, 0.f, 0.f);
            fov = 60.f;
        }
        if (Engine::InputManager::IsKeyDown(Engine::Key::LAlt) &&
            Engine::InputManager::IsKeyPressed(Engine::Key::L))
            lightIntensity = 3.f;

        if (Engine::InputManager::IsKeyPressed(Engine::Key::F4))
        {
            showShadows = !showShadows;   renderer3D.EnableShadows(showShadows);
        }
        if (Engine::InputManager::IsKeyPressed(Engine::Key::F5))
        {
            showPtShadows = !showPtShadows; renderer3D.EnablePointShadows(showPtShadows);
        }

        if (Engine::InputManager::IsKeyPressed(Engine::Key::Up))
            shadowQuality = std::min(shadowQuality + 1, 3);
        if (Engine::InputManager::IsKeyPressed(Engine::Key::Down))
            shadowQuality = std::max(shadowQuality - 1, 0);
        if (Engine::InputManager::IsKeyDown(Engine::Key::LAlt) &&
            Engine::InputManager::IsKeyDown(Engine::Key::U))
        {
            renderer3D.SetShadowQuality(static_cast<Engine::ShadowQuality>(shadowQuality));
            renderer3D.SetPointShadowQuality(static_cast<Engine::PointShadowQuality>(shadowQuality));
            LOG_INFO("Shadow quality -> {}.", shadowQuality);
        }

        renderer.Resize(window.GetWidth(), window.GetHeight());
        camera2D.SetViewSize((float)window.GetWidth(), (float)window.GetHeight());
        camera3D.SetPerspective(fov,
            (float)window.GetWidth() / (float)window.GetHeight(), 0.1f, 1000.f);

        // ---- Lighting (before BeginScene) ----
        Engine::DirectionalLight sun;
        sun.Direction = { 0.4f, -1.f, 0.5f };
        sun.Color = { 1.f, 0.95f, 0.88f };
        sun.Intensity = 0;
        renderer3D.SetDirectionalLight(sun);

        Engine::PointLight redLight;
        redLight.Position = { 4.f, 3.f, 0.f };
        redLight.Color = { 1.f, 0.15f, 0.05f };
        redLight.Intensity = 400.f * lightIntensity;
        redLight.Radius = 150.f;

        Engine::PointLight blueLight;
        blueLight.Position = { -4.f, 3.f, 0.f };
        blueLight.Color = { 0.05f, 0.3f, 1.f };
        blueLight.Intensity = 400.f * lightIntensity;
        blueLight.Radius = 150.f;

        renderer3D.ClearPointLights();
        renderer3D.AddPointLight(redLight);
        renderer3D.AddPointLight(blueLight);

        // ---- Materials ----
        Engine::Material groundMat; groundMat.Albedo = { 0.25f,0.25f,0.25f }; groundMat.Roughness = 0.95f;
        Engine::Material redMat;    redMat.Albedo = { 0.8f,0.08f,0.08f };  redMat.Roughness = 0.7f;
        Engine::Material goldMat;   goldMat.Albedo = { 1.f,0.76f,0.33f };   goldMat.Metallic = 1.f; goldMat.Roughness = 0.15f;
        Engine::Material ironMat;   ironMat.Albedo = { 0.56f,0.57f,0.58f }; ironMat.Metallic = 1.f; ironMat.Roughness = 0.6f;
        Engine::Material blueMat;   blueMat.Albedo = { 0.05f,0.2f,0.85f };  blueMat.Roughness = 0.4f;
        Engine::Material whiteMat;  whiteMat.Albedo = { 0.9f,0.9f,0.9f };    whiteMat.Roughness = 0.3f;
        Engine::Material redBulbMat;  redBulbMat.Albedo = { 1.f,0.15f,0.05f };  redBulbMat.Roughness = 0.3f;
        Engine::Material blueBulbMat; blueBulbMat.Albedo = { 0.05f,0.3f,1.f };   blueBulbMat.Roughness = 0.3f;

        // ---- Render ----
        renderer.BeginFrame(0.08f, 0.08f, 0.1f);
        renderer3D.BeginScene(camera3D);

        auto drawScene = [&]()
            {
                renderer3D.DrawMesh(ground, ground.GetWorldMatrix(), groundMat);
                renderer3D.DrawMesh(cube1, cube1.GetWorldMatrix(), redMat);
                renderer3D.DrawMesh(cube2, cube2.GetWorldMatrix(), goldMat);
                renderer3D.DrawMesh(cube3, cube3.GetWorldMatrix(), ironMat);
                renderer3D.DrawMesh(sphere1, sphere1.GetWorldMatrix(), blueMat);
                renderer3D.DrawMesh(sphere2, sphere2.GetWorldMatrix(), goldMat);
                renderer3D.DrawMesh(sphere3, sphere3.GetWorldMatrix(), whiteMat);
            };

        renderer3D.BeginShadowPass();
        drawScene();
        renderer3D.EndShadowPass();

        renderer3D.BeginPointShadowPass();
        for (int light = 0; light < 2; light++)
            for (int face = 0; face < 6; face++)
            {
                renderer3D.RenderPointShadowFace(light, face);
                drawScene();
            }
        renderer3D.EndPointShadowPass();

        if (showGrid) grid.Draw(camera3D);
        drawScene();

        if (bulbLoaded)
        {
            bulb.SetPosition(redLight.Position.x, redLight.Position.y, redLight.Position.z);
            renderer3D.DrawMesh(bulb, bulb.GetWorldMatrix(), redBulbMat);
            bulb.SetPosition(blueLight.Position.x, blueLight.Position.y, blueLight.Position.z);
            renderer3D.DrawMesh(bulb, bulb.GetWorldMatrix(), blueBulbMat);
        }

        // ---- UI ----
        renderer2D.BeginScene(camera2D);
        renderer2D.BeginScreenSpace();

        if (showInfo)
        {
            auto cam = camera3D.GetPosition();
            std::string info =
                "FPS:        " + std::to_string((int)timer.FPS()) + "\n"
                "Frame:      " + std::to_string(timer.DeltaTime() * 1000.f).substr(0, 5) + " ms\n"
                "\nCamera\n"
                "  Pos: (" + std::to_string((int)cam.x) + ", "
                + std::to_string((int)cam.y) + ", "
                + std::to_string((int)cam.z) + ")\n"
                "  FOV: " + std::to_string((int)fov) + " deg\n"
                "\nLights\n"
                "  Intensity:     " + std::to_string(lightIntensity).substr(0, 4) + "\n"
                "  Dir shadows:   " + (showShadows ? "on" : "off") + "\n"
                "  Point shadows: " + (showPtShadows ? "on" : "off") + "\n"
                "  Quality idx:   " + std::to_string(shadowQuality) + "\n"
                "\nControls\n"
                "  WASD/Space/Ctrl  move\n"
                "  RMB              look\n"
                "  RMB+Scroll       FOV\n"
                "  L+Scroll         light intensity\n"
                "  LAlt+L           reset light\n"
                "  R                reset camera\n"
                "  G / C            grid / crosshair\n"
                "  F4               dir shadows\n"
                "  F5               point shadows\n"
                "  Up/Down          quality\n"
                "  LAlt+U           apply quality";
            renderer2D.DrawText(font, info, 10.f, 10.f, 1.f, 1.f, 1.f);
        }
        else
            renderer2D.DrawText(font, "F3  info", 10.f, 10.f, 0.6f, 0.6f, 0.6f);

        if (showCrosshair)
            renderer2D.DrawText(font, "+",
                (float)window.GetWidth() / 2.f - 4.f,
                (float)window.GetHeight() / 2.f - 8.f,
                1.f, 1.f, 1.f);

        renderer2D.Flush();
        renderer.EndFrame();
    }

    grid.Shutdown();
    renderer3D.Shutdown();
    renderer2D.Shutdown();
    Engine::GamepadManager::Shutdown();
    Engine::InputManager::Shutdown();
    LOG_INFO("Shutting down.");
    return 0;
}